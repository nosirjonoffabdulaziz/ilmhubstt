# ============ ilmhubstt sozlamalari ============
# Bu faylni .env nomi bilan nusxalang va kerakli qiymatlarni o'zgartiring.

# --- Server ---
HOST=127.0.0.1                 # telefon uchun: run.py --lan (0.0.0.0)
PORT=8000
# DATA_DIR=./data              # ishlar va natijalar papkasi
# MODEL_DIR=./models           # yuklab olingan modellar keshi

# --- Cheklovlar ---
MAX_UPLOAD_MB=1024             # 2 soatlik video uchun yetarli
MAX_DURATION_MIN=180           # 3 soat
RETENTION_HOURS=24             # natija shuncha soatdan keyin o'chiriladi
MAX_QUEUED_JOBS=50
RATE_LIMIT_PER_HOUR=30         # bir IP dan soatiga yangi ishlar (0 = cheksiz)
WORKERS=1                      # bir vaqtda nechta ish (CPU da 1 tavsiya etiladi)

# --- Lokal ASR (tekin): faster-whisper ---
ASR_ENGINE=faster-whisper
DEFAULT_QUALITY=balanced       # fast | balanced | best
WHISPER_MODEL_FAST=small
WHISPER_MODEL_BALANCED=medium
WHISPER_MODEL_BEST=large-v3-turbo
WHISPER_DEVICE=auto            # auto | cpu | cuda
WHISPER_COMPUTE_TYPE=auto      # auto (cpu=int8, cuda=float16) | int8 | int8_float16 | float16
WHISPER_CPU_THREADS=0          # 0 = avtomatik
WHISPER_BEAM_SIZE=5
CHUNK_MINUTES=10               # uzun audio shu uzunlikdagi bo'laklarga (pauzada) bo'linadi
UNCERTAIN_WORD_PROB=0.5        # shundan past ishonchli so'zlar "noaniq" deb belgilanadi

# Til bo'yicha alohida model (masalan, o'zbekchaga fine-tune qilingan CTranslate2 model papkasi yoki HF nomi)
# WHISPER_MODEL_UZ=C:\models\whisper-uz-ct2
# WHISPER_MODEL_KY=
# Whisper qirg'iz tilini qo'llamaydi; qaysi til kodi bilan ishlatish (standart: kk)
# WHISPER_LANG_KY=kk

# --- Lokal AI muharrir (tekin, internetsiz): Ollama ---
# O'rnatish: scripts\setup_ai_editor_windows.bat  (yoki: winget install Ollama.Ollama ; ollama pull gemma3:12b)
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=gemma3:12b        # kuchsizroq kompyuter: gemma3:4b ; o'zbekchaga moslangan: README ga qarang
OLLAMA_TIMEOUT=900
AI_PROOFREAD_DEFAULT=1         # Ollama ishlayotgan bo'lsa, AI muharrir standart yoqiq

# --- Google Gemini (bulut; bepul yoki pullik kalit) ---
# Kalitni saytdagi Sozlamalar sahifasidan kiritish qulayroq (tekshiradi va shu yerga o'zi yozadi).
# GEMINI_API_KEY=
GEMINI_MODEL=gemini-3-flash-preview
# GEMINI_FALLBACK_MODELS=gemini-3-flash-preview,gemini-2.5-flash,gemini-2.5-flash-lite
# GEMINI_MAX_WAIT=900          # limit (429) tugashini jami necha soniya kutish
# GEMINI_PRICE_IN=1.0          # narx hisobi uchun, USD / 1M token (bo'sh = jadvaldan)
# GEMINI_PRICE_OUT=3.0

# --- Bulut ASR (pullik, ixtiyoriy): ElevenLabs Scribe ---
# Kalit berilsa, interfeysda "ElevenLabs (bulut)" dvigateli paydo bo'ladi.
# ELEVENLABS_API_KEY=
# ELEVENLABS_MODEL=scribe_v2

# --- Xavfsizlik (internetga yoki LAN ga ochganda MAJBURIY) ---
# APP_ACCESS_KEY=uzun-tasodifiy-parol
# CORS_ORIGINS=https://stt.sizning-domen.uz   # frontend boshqa domenda bo'lsa
# TRUST_PROXY=1                                # Caddy/Nginx ortida bo'lsa

# --- Faqat test uchun ---
# ENABLE_DUMMY_ENGINE=1        # nutqni TANIMAYDIGAN demo dvigatel (interfeysni sinash)
